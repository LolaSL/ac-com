# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production           # "development" locally, "production" on Render/Heroku
PORT=5020

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# The URL of your deployed frontend (used in production to restrict CORS)
FRONTEND_URL=https://your-app.onrender.com

# ── Payments ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email ─────────────────────────────────────────────────────────────────────
MAILGUN_API_KEY=your_mailgun_api_key
SENDGRID_API_KEY=SG.your_sendgrid_key   # optional if using SendGrid instead

# ── Base URL (used in email links) ───────────────────────────────────────────
BASE_URL=https://your-app.onrender.com

# ── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key
